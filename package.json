{
  "name": "swagger-to-api",
  "version": "1.0.0",
  "description": "Generate typescript or javascript services and models from Swagger",
  "main": "./lib/index.js",
  "bin": {
    "swagger-to-api": "./lib/index.js"
  },
  "files": [
    "lib",
    "template"
  ],
  "scripts": {
    "clear": "rm -rf ./dist",
    "dev": "yarn clear && ts-node src/index.ts",
    "build": "yarn clear && tsc -p .",
    "test": "yarn clear && yarn build && node lib/index.js",
    "release": "yarn clear && yarn build && npm publish --registry=https://registry.npmjs.org/",
    "mock": "ts-node-dev src/mock.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenquan/swagger-to-api.git"
  },
  "keywords": [
    "swagger",
    "typescript",
    "code generator"
  ],
  "author": "zenquan",
  "license": "Apache",
  "bugs": {
    "url": "https://github.com/zenquan/swagger-to-api/issues"
  },
  "homepage": "https://github.com/zenquan/swagger-to-api#readme",
  "dependencies": {
    "@apidevtools/swagger-parser": "^9.0.1",
    "api-spec-converter": "^2.12.0",
    "axios": "^1.4.0",
    "chalk": "^4.0.0",
    "commander": "^5.0.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "mockjs": "^1.1.0",
    "mustache": "^4.0.1",
    "path": "^0.12.7",
    "urijs": "^1.19.11"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.170",
    "@types/lodash-es": "^4.17.4",
    "@types/mustache": "^4.0.1",
    "@types/node": "^13.13.0",
    "@types/urijs": "^1.19.19",
    "@typescript-eslint/eslint-plugin": "^2.28.0",
    "@typescript-eslint/parser": "^2.28.0",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.10.1",
    "eslint-config-standard": "^14.1.1",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^3.1.3",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-standard": "^4.0.1",
    "express": "^4.18.2",
    "openapi-types": "^1.3.5",
    "prettier": "^2.0.4",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.4"
  }
}
